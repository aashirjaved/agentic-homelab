{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-homelab.dev/schemas/mcp-server.schema.json",
  "title": "Agentic Homelab MCP Server Manifest",
  "type": "object",
  "required": ["id", "name", "status", "transport", "risk_default", "tools"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "status": { "enum": ["scaffold", "experimental", "stable"] },
    "transport": { "enum": ["stdio", "http", "sse", "streamable-http"] },
    "risk_default": { "$ref": "#/$defs/risk" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "risk"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "risk": { "$ref": "#/$defs/risk" },
          "requires_approval": { "type": "boolean" },
          "description": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "risk": {
      "enum": ["read", "plan", "write", "destructive", "credential-access"]
    }
  },
  "additionalProperties": true
}

