{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-homelab.dev/schemas/policy.schema.json",
  "title": "Agentic Homelab Guardrail Policy",
  "type": "object",
  "required": ["name", "defaults"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "defaults": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": { "enum": ["read-only", "approval-gated", "manual"] },
        "require_approval_for": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "additionalProperties": true
    },
    "allow": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    },
    "deny_without_approval": {
      "type": "array",
      "items": { "$ref": "#/$defs/rule" }
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": ["id", "risk"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "risk": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}

