{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-homelab.dev/schemas/inventory.schema.json",
  "title": "Agentic Homelab Inventory",
  "type": "object",
  "required": ["homelab", "nodes"],
  "properties": {
    "homelab": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    },
    "storage": {
      "type": "array",
      "items": { "$ref": "#/$defs/storage" }
    },
    "networks": {
      "type": "object",
      "additionalProperties": true
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "address": { "type": "string" },
        "access": { "type": "object", "additionalProperties": true },
        "risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "service": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "runs_on": { "type": "string" },
        "exposure": { "type": "string" }
      },
      "additionalProperties": true
    },
    "storage": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "backup_status": { "type": "string" },
        "mounted_by": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "status": { "type": "string" },
        "model_route_policy": { "type": "string" }
      },
      "additionalProperties": true
    }
  }
}

