{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-homelab.dev/schemas/inventory.schema.json",
  "title": "Agentic Homelab Inventory",
  "type": "object",
  "required": ["nodes"],
  "properties": {
    "homelab": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "owner": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "nodes": {
      "oneOf": [
        {
          "type": "array",
          "items": { "$ref": "#/$defs/node" }
        },
        {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/keyedNode" }
        }
      ]
    },
    "services": {
      "type": "array",
      "items": { "$ref": "#/$defs/service" }
    },
    "storage": {
      "type": "array",
      "items": { "$ref": "#/$defs/storage" }
    },
    "networks": {
      "type": "object",
      "additionalProperties": true
    },
    "agents": {
      "type": "array",
      "items": { "$ref": "#/$defs/agent" }
    },
    "restore_tests": {
      "type": "array",
      "items": { "$ref": "#/$defs/restoreTest" }
    }
  },
  "$defs": {
    "node": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "role": { "type": "string" },
        "address": { "type": "string" },
        "access": { "type": "object", "additionalProperties": true },
        "risks": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": true
    },
    "keyedNode": {
      "type": "object",
      "properties": {
        "role": { "type": "string" },
        "display_name": { "type": "string" },
        "parent": { "type": "string" },
        "proxmox_ctid": { "type": ["integer", "string"] },
        "proxmox_node_name": { "type": "string" },
        "lan_ip": { "type": "string" },
        "tailscale_ip": { "type": "string" },
        "ssh": { "type": "string" },
        "capabilities": { "type": "array", "items": { "type": "string" } },
        "services": { "type": "object", "additionalProperties": true },
        "mounts": { "type": "object", "additionalProperties": { "type": "string" } },
        "stacks": { "type": "object", "additionalProperties": true },
        "storage_pool": { "type": "string" }
      },
      "additionalProperties": true
    },
    "service": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "runs_on": { "type": "string" },
        "exposure": { "type": "string" },
        "uses_storage": { "type": "array", "items": { "type": "string" } },
        "depends_on": { "type": "array", "items": { "type": "string" } },
        "healthcheck": { "$ref": "#/$defs/healthcheck" },
        "recovery": {
          "type": "object",
          "properties": {
            "configuration_status": { "type": "string" },
            "secrets_required": { "type": "boolean" },
            "secrets_status": { "type": "string" },
            "data_required": { "type": "boolean" },
            "restore_runbook": { "type": ["string", "boolean"] },
            "last_restore_test": { "type": "string" },
            "restore_test": { "$ref": "#/$defs/restoreTestEvidence" }
          },
          "additionalProperties": true
        },
        "update": {
          "type": "object",
          "properties": {
            "available": { "type": "boolean" },
            "current_version": { "type": "string" },
            "target_version": { "type": "string" },
            "release_notes_reviewed": { "type": "boolean" },
            "breaking_changes_reviewed": { "type": "boolean" },
            "rollback": { "type": ["string", "boolean"] },
            "verification": { "type": "array", "items": { "type": "string" } }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    },
    "storage": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "backup_status": { "type": "string" },
        "mounted_by": { "type": "array", "items": { "type": "string" } },
        "independent_backup": { "type": "boolean" },
        "failure_domain": { "type": "string" },
        "backup_failure_domain": { "type": "string" },
        "healthcheck": { "$ref": "#/$defs/healthcheck" }
      },
      "additionalProperties": true
    },
    "agent": {
      "type": "object",
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string" },
        "status": { "type": "string" },
        "model_route_policy": { "type": "string" }
      },
      "additionalProperties": true
    },
    "restoreTestEvidence": {
      "type": "object",
      "required": ["status"],
      "properties": {
        "status": { "type": "string", "enum": ["passed", "failed", "unknown"] },
        "tested_at": { "type": "string" },
        "scope": { "type": "string" },
        "evidence": { "type": "string" },
        "notes": { "type": "string" }
      },
      "additionalProperties": true
    },
    "restoreTest": {
      "allOf": [
        { "$ref": "#/$defs/restoreTestEvidence" },
        {
          "type": "object",
          "properties": {
            "service": { "type": "string" },
            "service_id": { "type": "string" },
            "services": { "type": "array", "items": { "type": "string" } }
          },
          "anyOf": [
            { "required": ["service"] },
            { "required": ["service_id"] },
            { "required": ["services"] }
          ]
        }
      ]
    },
    "healthcheck": {
      "type": "object",
      "properties": {
        "url": { "type": "string", "pattern": "^https?://" },
        "url_env": { "type": "string" },
        "expected_status": {
          "oneOf": [
            { "type": "integer", "minimum": 100, "maximum": 599 },
            { "type": "array", "items": { "type": "integer", "minimum": 100, "maximum": 599 } }
          ]
        },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 15 },
        "mode": { "type": "string", "enum": ["health", "reachability"] },
        "scope": { "type": "string" }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["url"] },
        { "required": ["url_env"] }
      ]
    }
  }
}
