{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-homelab.dev/schemas/workflow.schema.json",
  "title": "Agentic Homelab Example Workflow",
  "type": "object",
  "required": ["id", "title", "risk_default", "steps", "verification"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "risk_default": { "$ref": "#/$defs/risk" },
    "required_skills": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "required_mcp_servers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "optional_mcp_servers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "action", "risk"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "action": { "type": "string", "minLength": 1 },
          "risk": { "$ref": "#/$defs/risk" }
        },
        "additionalProperties": true
      }
    },
    "approval_required_for": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "$defs": {
    "risk": {
      "enum": ["read", "plan", "write", "destructive", "credential-access"]
    }
  },
  "additionalProperties": true
}
