{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-homelab.dev/schemas/action-risk-matrix.schema.json",
  "title": "Agentic Homelab Action Risk Matrix",
  "type": "object",
  "required": ["name", "version", "categories"],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "version": { "type": "string", "minLength": 1 },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "decision", "requires_approval", "examples", "required_evidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "decision": {
            "enum": [
              "allow_readonly",
              "approval_required",
              "destructive_approval_required",
              "unknown_requires_review"
            ]
          },
          "requires_approval": { "type": "boolean" },
          "examples": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "required_evidence": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
